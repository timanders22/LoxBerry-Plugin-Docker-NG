#!/bin/bash
# Docker NG - Deinstallation
#
# Bis 1.1.0 gab es dieses Skript nicht: Portainer lief nach dem Entfernen des
# Plugins weiter, und die Sicherung mit dem Merkwort blieb auf der Karte
# liegen. Gemeldet von einem Mitleser, zutreffend.
#
# Was hier absichtlich NICHT passiert: Docker wird nicht entfernt. Auf einem
# LoxBerry haengen daran regelmaessig weitere Container - Sprachdienste,
# Datenbanken, anderes. Ein Plugin, das beim Deinstallieren fremde Container
# mitreisst, ist gefaehrlicher als eines, das etwas stehen laesst. Der Befehl
# dafuer steht unten, auszufuehren bleibt Sache des Anwenders.

# D2/D15 (1.3.19): Wurzel in Hausform; Rueckfall DREI Ebenen vom Ablageort data/system/uninstall/<name> (Regeln/06;
# bis 1.3.18 zwei - das traf data/). Keine Wurzel oder ein unbrauchbarer Ordnername: es wird NICHTS geloescht und
# nichts beendet (Rueckgabe 0 - die Deinstallation des Plugins selbst laeuft weiter).
dk_ist_wurzel() {
    [ -n "$1" ] && [ -d "$1/config/plugins" ] && [ -d "$1/data/plugins" ] \
        && [ -f "$1/config/system/general.json" ]
}
PFOLDER="${3:-}"
case "$PFOLDER" in
    ''|*[!A-Za-z0-9_-]*) echo "<FAIL> Ordnername '$PFOLDER' unbrauchbar - es wird NICHTS beendet und NICHTS geloescht."; exit 0 ;;
esac
BASE=""
for dk_k in "${5:-}" "${LBHOMEDIR:-}" "$(cd "$(dirname "$(readlink -f "$0")")/../../.." 2>/dev/null && pwd)"; do
    if dk_ist_wurzel "$dk_k"; then BASE="$dk_k"; break; fi
done
if [ -z "$BASE" ]; then
    echo "<FAIL> Keine LoxBerry-Wurzel gefunden (config/plugins, data/plugins und config/system/general.json) - es"
    echo "<FAIL> wurde NICHTS geloescht. Bitte von Hand nachsehen: config/plugins/$PFOLDER.backup.json,"
    echo "<FAIL> data/plugins/$PFOLDER.upgrade_laeuft, data/plugins/$PFOLDER.mqtt_*.json"
    exit 0
fi
CF="$BASE/config/plugins/$PFOLDER/dockerng.json"
BK="$BASE/config/plugins/$PFOLDER.backup.json"
BINDIR="$BASE/bin/plugins/$PFOLDER"

# Frist fuer docker- und php-Aufrufe (C3): dieses Skript laeuft als root unter
# der Sperre von plugininstall.pl; haengt dockerd, hing bis 1.3.9 die ganze
# Deinstallation. Ohne timeout laeuft der Befehl wie bisher.
dk_frist() {
    n="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 2 "$n" "$@"
    else
        "$@"
    fi
}

# ---------- Befehlsbruecke anhalten (V3, 1.3.19; Bauart Ferien 1.2.28 uninstall) ----------
# stop beendet Dienst und mosquitto_sub, auch ein verwaistes; danach argumentweise nachzaehlen, die Optionsdateien mit
# dem Broker-Kennwort ueberschreiben und den Ordner befehle/ entfernen. Im Broker bleibt nichts: Quittungen und
# status/befehle sind nie zurueckbehalten.
BBSH="$BASE/bin/plugins/$PFOLDER/befehlsbruecke.sh"
BBPHP="$BASE/bin/plugins/$PFOLDER/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PFOLDER/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop
fi
BB_REST=0
for d in /proc/[0-9]*; do
    mapfile -d '' -t a 2>/dev/null < "$d/cmdline" || continue
    if [ "${#a[@]}" -eq 2 ] && [ "${a[1]}" = "$BBPHP" ] && [[ "${a[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${d#/proc/}" 2>/dev/null
        BB_REST=$((BB_REST + 1))
    fi
done
BB_ABOS=0
for d in /proc/[0-9]*; do
    read -r c 2>/dev/null < "$d/comm" || continue
    [ "$c" = "mosquitto_sub" ] || continue
    mapfile -d '' -t e 2>/dev/null < "$d/environ" || continue
    for x in "${e[@]}"; do
        if [ "$x" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${d#/proc/}" 2>/dev/null; BB_ABOS=$((BB_ABOS + 1)); fi
    done
done
[ "$BB_REST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_REST Dienst(e) erst mit kill -9 beendet."
[ "$BB_ABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_ABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$f" ]; then
            n=$(stat -c %s "$f" 2>/dev/null || echo 64)
            head -c "$n" /dev/zero > "$f" 2>/dev/null
        fi
    done
    rm -rf "${BBDIR:?}"
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
elif [ -f "$BBSH" ]; then
    echo "<OK> Befehlsbruecke angehalten, ihre Zugangsdaten entfernt."
fi

# ---------- Den EIGENEN Container anhalten und entfernen (C1, Entscheidung 9) ----------
# BERICHTIGT in 1.3.9: bis dahin entfernte dieses Skript den Container, den das
# Feld portainer_name nannte - gleich, wer ihn angelegt hatte. Gemessen: mit
# dem Namen des MG-Gateways im Feld wurde das Gateway angehalten und geloescht;
# ein portainer-ce des Anwenders ebenso, waehrend der eigene Portainer
# weiterlief. Jetzt entscheidet bin/dk_eigen.php - dieselbe Pruefung wie beim
# Knopf "Portainer neu starten" und in postroot.sh: Label, im Altbestand Name
# portainer UND Abbild portainer/portainer-*. Vor jedem Namen steht '--' (C6).
NAME=""
if command -v docker >/dev/null 2>&1; then
    LAGE=""
    LAGE_RC=2
    if [ -f "$BINDIR/dk_eigen.php" ] && command -v php >/dev/null 2>&1; then
        LAGE=$(dk_frist 120 php "$BINDIR/dk_eigen.php" "$PFOLDER" 2>/dev/null)
        LAGE_RC=$?
    fi
    EIGEN_GRUND=""
    FREMDE=""
    PRUEF_FEHLER=""
    TAB=$(printf '\t')
    while IFS="$TAB" read -r dk_art dk_n dk_g dk_l dk_b; do
        case "$dk_art" in
            EIGEN)  NAME="$dk_n"; EIGEN_GRUND="$dk_g" ;;
            FREMD)  FREMDE="$FREMDE $dk_n ($dk_l, $dk_g)" ;;
            FEHLER) PRUEF_FEHLER="$dk_n" ;;
        esac
    done <<< "$LAGE"
    if [ "$LAGE_RC" != "0" ] || [ -n "$PRUEF_FEHLER" ]; then
        NAME=""
        echo "<FAIL> Welcher Container zu diesem Plugin gehoert, liess sich nicht pruefen"
        echo "<FAIL> (${PRUEF_FEHLER:-Rueckgabewert $LAGE_RC}). Es wird KEIN Container angefasst."
        echo "<INFO> Von Hand nachsehen:  docker ps -a --filter label=de.loxberry.plugin.folder=$PFOLDER"
    elif [ -n "$NAME" ]; then
        # Wirkung nachzaehlen, nicht dem Rueckgabewert des Aufrufs glauben.
        dk_frist 30 docker stop -- "$NAME" >/dev/null 2>&1
        dk_frist 30 docker rm -- "$NAME" >/dev/null 2>&1
        if dk_frist 30 docker inspect --type container -- "$NAME" >/dev/null 2>&1; then
            echo "<FAIL> Der eigene Container $NAME liess sich NICHT entfernen."
            echo "<INFO> Von Hand nachholen:  docker rm -f -- $NAME"
        else
            echo "<OK> Eigener Container $NAME angehalten und entfernt ($EIGEN_GRUND)."
        fi
    else
        echo "<INFO> Es gibt keinen Container, der zu diesem Plugin gehoert - nichts zu entfernen."
    fi
    if [ -n "$FREMDE" ]; then
        echo "<INFO> Nicht angefasst, weil sie nicht zu diesem Plugin gehoeren:$FREMDE"
    fi
    # BERICHTIGT in 1.2.4: hier stand "docker volume rm portainer_data".
    # postroot.sh haengt Portainers Datenverzeichnis aber als HOSTPFAD ein
    # (--volume=/opt/portainer:/data), nicht als benannten Datentraeger. Der
    # genannte Befehl endete deshalb mit "no such volume" - der Anwender
    # glaubte aufgeraeumt zu haben, waehrend die Portainer-Konten samt
    # Kennwort-Hashes weiter auf der Karte lagen. Und der richtige Ort stand
    # nirgends, er konnte ihn also nicht einmal selbst finden.
    DATENORT="/opt/portainer"
    echo "<INFO> Das Datenverzeichnis von Portainer bleibt erhalten:"
    if [ -d "$DATENORT" ]; then
        echo "<INFO>   $DATENORT  (vorhanden, $(du -sh "$DATENORT" 2>/dev/null | cut -f1))"
    else
        echo "<INFO>   $DATENORT  (nicht vorhanden - offenbar anders eingerichtet)"
        echo "<INFO> Den wirklichen Ort nennt:  docker inspect --format '{{json .Mounts}}' -- ${NAME:-portainer}"
    fi
    echo "<INFO> Es enthaelt Ihre Portainer-Benutzer und -Einstellungen."
    echo "<INFO> Entfernen mit:  sudo rm -rf $DATENORT"
    echo "<INFO> Docker selbst bleibt installiert - daran haengen moeglicherweise"
    echo "<INFO> weitere Container. Entfernen mit:  sudo apt purge docker-ce docker-ce-cli containerd.io"
    # Ab 1.3.0 richtet postroot.sh eine Log-Rotation in /etc/docker/daemon.json
    # ein. Sie wird BEWUSST nicht zurueckgenommen: sie schuetzt das
    # Dateisystem, sie gehoert inzwischen zum System und nicht mehr zu diesem
    # Plugin, und ein Plugin, das beim Deinstallieren eine Schutzeinstellung
    # entfernt, ist gefaehrlicher als eines, das etwas stehen laesst. Wer sie
    # loswerden will, bekommt gesagt wie.
    if [ -f /etc/docker/daemon.json ]; then
        echo "<INFO> Die Log-Rotation in /etc/docker/daemon.json bleibt bestehen - sie"
        echo "<INFO> schuetzt die Speicherkarte und gehoert jetzt zum System."
        echo "<INFO> Zuruecknehmen: den Abschnitt log-opts aus der Datei entfernen."
    fi
else
    echo "<INFO> docker ist nicht vorhanden - es ist nichts anzuhalten."
fi

# ---------- Zurueckbehaltene MQTT-Themen abraeumen (M4, Entscheidung 3) ----------
# Nur eigene Themen unter dem eingestellten Praefix (seit 1.3.19 auch Wachliste, Gedaechtnis und die aktuellen
# Container, D11) und was zum Abraeumen vorgemerkt war - seit 1.3.19 in einer kurzen TCP-Sitzung mit Ruecklesen
# (E-E8), ohne Brokerzugang ueber den UDP-Eingang. Muss VOR dem Entfernen der Konfiguration laufen (sie traegt das
# Praefix). Protokolliert nichts (laeuft als root). Die Zeilen tragen ihre Kennung selbst; Rueckgabe immer 0.
if [ -f "$BINDIR/dockerng_takt.php" ] && command -v php >/dev/null 2>&1; then
    MAUS=$(dk_frist 60 php "$BINDIR/dockerng_takt.php" --mqtt-leeren 2>&1)
    MRC=$?
    case "$MAUS" in
        "<"*) echo "$MAUS" ;;
        *) echo "<INFO> MQTT: ${MAUS:-keine Ausgabe} (Rueckgabewert $MRC). Pruefen mit dem MQTT-Finder von LoxBerry." ;;
    esac
fi

# ---------- Geheimnis wegraeumen ----------
# Die Sicherung enthaelt das Merkwort fuer den unangemeldeten Endpunkt, die
# Datei setup_token den Einrichtungstoken von Portainer. Beide werden
# ueberschrieben, bevor sie geloescht werden: ein blosses rm laesst den Inhalt
# auf der Karte stehen, bis der Block neu belegt wird.
#
# ZUR EINORDNUNG: auf einer Speicherkarte oder eMMC entscheidet der
# Flash-Controller selbst, wohin geschrieben wird (Wear-Leveling) - der alte
# Block kann physisch stehen bleiben. Das Ueberschreiben ist deshalb eine
# Erschwernis, keine Garantie. Der Kommentar bis 1.2.4 hat mehr behauptet.
# SEIT 1.3.9 dazu: die Zweitschrift des Einrichtungstokens (I5) und die
# beiseitegelegten .alt-Dateien einer frueheren Installation (I1).
for DATEI in "$BK" "$CF" "$BASE/config/plugins/$PFOLDER/setup_token" \
             "$BK.neu" "$BK.alt" "$BK.neu.alt" \
             "$BASE/config/plugins/$PFOLDER.backup.setup_token" \
             "$BASE/config/plugins/$PFOLDER.backup.setup_token.alt"; do
    if [ -f "$DATEI" ]; then
        dd if=/dev/zero of="$DATEI" bs=1k count=8 conv=notrunc >/dev/null 2>&1
        rm -f "$DATEI" && echo "<OK> $DATEI ueberschrieben und entfernt."
    fi
done
# Upgrade-Marke (I1) und Sperrdateien neben dem Datenordner (I7, C9).
# Seit 1.3.19 (E-E7) dazu das MQTT-Gedaechtnis und die Vormerkung neben dem Datenordner - erst hier, NACH
# --mqtt-leeren, das sie liest.
for DATEI in "$BASE/data/plugins/$PFOLDER.upgrade_laeuft" \
             "$BASE/data/plugins/$PFOLDER.cron.lock" \
             "$BASE/data/plugins/$PFOLDER.takt.lock" \
             "$BASE/data/plugins/$PFOLDER.mqtt_gedaechtnis.json" \
             "$BASE/data/plugins/$PFOLDER.mqtt_abraeumen.json"; do
    if [ -f "$DATEI" ]; then
        rm -f "$DATEI" && echo "<OK> $DATEI entfernt."
    fi
done

echo "<OK> Deinstallation abgeschlossen."
exit 0
